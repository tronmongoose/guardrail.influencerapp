# ── Database ──────────────────────────────────────────────────────────────────
# Neon in prod; use docker-compose.yml locally (port 5433)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── File Storage (Vercel Blob) ────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
# If absent, emails are logged to console in dev and silently dropped in prod
RESEND_API_KEY=re_...
# Must match a verified domain in your Resend account
EMAIL_FROM=GuideRail <noreply@yourdomain.com>

# ── AI ────────────────────────────────────────────────────────────────────────
# LLM_PROVIDER: stub | anthropic | openai | gemini  (stub = no API calls, safe for dev)
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
HUGGINGFACEHUB_API_TOKEN=hf_...
GOOGLE_AI_API_KEY=...

# ── Video (Mux) ───────────────────────────────────────────────────────────────
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
MUX_WEBHOOK_SECRET=your_mux_webhook_secret

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated Clerk user IDs that can access /admin (transaction dashboard)
# Find your Clerk user ID in the Clerk dashboard under Users
ADMIN_USER_IDS=user_abc123,user_def456
# Email address for admin notifications (new signups, publishes, enrollments)
ADMIN_NOTIFICATION_EMAIL=admin@skillguide.net
# Comma-separated creator emails (case-insensitive) that see the generation debug panel.
# Adds per-step timing data to the /generate-async/status response and renders a right-side
# slide-over panel with step timeline + recent jobs. Leave empty in prod to hide entirely.
DEBUG_CREATOR_EMAILS=

# ── Platform access ───────────────────────────────────────────────────────────
# Comma-separated creator emails that bypass the per-program platform fee entirely.
# Use for internal/QA accounts. Skips publish-gate and short-circuits checkout.
# Discount codes for everyone else live in the Stripe Dashboard as Promotion Codes
# (checkout has allow_promotion_codes: true), not here.
PLATFORM_FEE_EXEMPT_EMAILS=

# ── Marketing Hub (/dashboard/ops) ────────────────────────────────────────────
# Meta Graph API token with `ads_read` scope — powers the Competitor Spy page.
# Create at: https://developers.facebook.com/tools/accesstoken/
META_AD_LIBRARY_TOKEN=
# Pipeboard API key — powers the Campaigns page (live Meta spend/clicks/conversions).
# Get at: https://pipeboard.co
PIPEBOARD_API_KEY=
