generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// --- User (linked to Clerk) ---

model User {
  id        String   @id @default(cuid())
  clerkId   String?  @unique  // Optional - only for creators using Clerk
  email     String   @unique
  name      String?
  role      Role     @default(LEARNER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Creator onboarding fields
  bio                String?  @db.Text
  niche              String?
  outcomeTarget      String?  @db.Text
  onboardingComplete Boolean  @default(false)

  // Stripe Connect fields (for creators)
  stripeAccountId       String?  @unique  // Stripe Connect account ID
  stripeAccountStatus   String?  // "pending", "active", "restricted"
  stripeOnboardingComplete Boolean @default(false)

  // Platform access fields
  platformPromoGranted    Boolean  @default(false)  // entered valid platform promo code
  platformPaymentComplete Boolean  @default(false)  // paid the one-time platform fee
  platformStripeSessionId String?  @unique          // Stripe session ID for platform payment

  programs            Program[]
  entitlements        Entitlement[]
  progress            LearnerProgress[]
  sessionProgress     LearnerSessionProgress[]
  followedInfluencers UserInfluencer[]
  magicLinks          MagicLink[]
  promoCodes          PromoCode[]
  customSkins         CustomSkin[]
}

// --- Magic Link for Learner Authentication ---

model MagicLink {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId String?  // Optional: link to specific program for context
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

enum Role {
  CREATOR
  LEARNER
  ADMIN
}

// --- Program ---

model Program {
  id               String      @id @default(cuid())
  title            String
  slug             String      @unique
  description      String?
  outcomeStatement String?     @db.Text
  durationWeeks    Int
  aiStructured     Boolean     @default(false)
  followUploadOrder Boolean    @default(false)
  pacingMode       PacingMode  @default(UNLOCK_ON_COMPLETE)
  priceInCents     Int         @default(0)
  currency         String      @default("usd")
  published        Boolean     @default(false)
  status           ProgramStatus @default(DRAFT)  // Deprecated: use `published` instead. Remove in next migration.
  stripeProductId  String?
  stripePriceId    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Enhanced program definition fields
  targetAudience       String?   @db.Text  // "Who it's for" / industry
  targetTransformation String?   @db.Text  // 1-2 sentence transformation goal
  vibePrompt           String?   @db.Text  // AI generation style guidance
  creatorAvatarUrl     String?   @db.Text  // Creator profile avatar image URL (Vercel Blob)
  skinId               String    @default("classic-minimal")
  customSkinId         String?
  customSkin           CustomSkin? @relation(fields: [customSkinId], references: [id])
  transitionMode       ProgramTransitionMode @default(NONE)

  // AI intent parser output (set during /new flow)
  videoGroups       Json?    // { clipIndexes: number[], title: string, combinable: boolean }[]
  sectionBoundaries Json?    // number[] — clip indexes where new sessions begin

  creatorId     String
  creator       User        @relation(fields: [creatorId], references: [id])

  @@index([creatorId])

  weeks            Week[]
  videos           YouTubeVideo[]
  drafts           ProgramDraft[]
  entitlements     Entitlement[]
  embeddings       Embedding[]
  clusters         ClusterAssignment[]
  cohorts          Cohort[]
  artifacts        ProgramArtifact[]
  rating           ProgramRating?
  generationJobs   GenerationJob[]
  styleInfluencers String[]  // Array of influencer IDs that influenced this program

  promoCodes       PromoCode[]
}

enum PacingMode {
  DRIP_BY_WEEK        // Weekly release: content unlocks on a time-based schedule
  UNLOCK_ON_COMPLETE  // Staged: next session/week unlocks after completing the current one
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
}

enum DurationPreset {
  SIX_WEEKS    // 6
  EIGHT_WEEKS  // 8
  TWELVE_WEEKS // 12
}

// --- Week / Session / Action ---

model Week {
  id         String   @id @default(cuid())
  title      String
  summary    String?
  weekNumber Int
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  sessions   Session[]

  @@unique([programId, weekNumber])
}

model Session {
  id           String   @id @default(cuid())
  title        String
  summary      String?
  orderIndex   Int
  weekId       String
  week         Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  actions      Action[]
  keyTakeaways   String[] // 2-3 key takeaway bullets per session
  hideTransition Boolean  @default(false)

  compositeSession CompositeSession?
  learnerProgress  LearnerSessionProgress[]

  @@index([weekId])
}

// Tracks "user finished watching this session's clips" for sessions backed by
// a CompositeSession (no typed WATCH Action exists, so LearnerProgress can't
// represent it). Manual toggles from the learner UI also flow through here.
model LearnerSessionProgress {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  watched         Boolean   @default(false)
  watchedAt       DateTime?
  // SessionClip IDs the learner has individually marked watched. Per-clip
  // granularity so a CompositeSession with N clips renders as N independent
  // steps in the learner UI. `watched` is the session-level rollup (true when
  // every clip is in this array, kept in sync server-side).
  watchedClipIds  String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, sessionId])
  @@index([userId])
}

model Action {
  id               String     @id @default(cuid())
  title            String
  type             ActionType
  instructions     String?
  reflectionPrompt String?
  orderIndex       Int
  sessionId        String
  session          Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  youtubeVideoId   String?
  youtubeVideo     YouTubeVideo? @relation(fields: [youtubeVideoId], references: [id])

  // Mux-hosted video fields
  muxUploadId   String?  // Mux direct upload ID (temporary until asset is ready)
  muxAssetId    String?  // Mux asset ID (set via video.upload.asset_created webhook)
  muxPlaybackId String?  // Mux playback ID (set via video.asset.ready webhook)
  muxStatus     String?  // "waiting" | "ready" | "errored"

  progress         LearnerProgress[]

  @@index([sessionId])
  @@index([muxUploadId])
  @@index([muxAssetId])
}

enum ActionType {
  WATCH
  READ
  DO
  REFLECT
}

// --- Composite Session (multi-clip playlist for a session) ---

enum ProgramTransitionMode {
  NONE
  SIMPLE
  BRANDED
}

enum TransitionType {
  NONE
  FADE
  CROSSFADE
  SLIDE_LEFT
}

enum OverlayType {
  TITLE_CARD
  CHAPTER_TITLE
  KEY_POINTS
  LOWER_THIRD
  CTA
  OUTRO
}

enum OverlayPosition {
  CENTER
  BOTTOM
  TOP
  LOWER_THIRD
}

model CompositeSession {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title         String?
  description   String?
  thumbnailUrl  String?
  autoAdvance   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clips    SessionClip[]
  overlays SessionOverlay[]
}

model SessionClip {
  id                   String         @id @default(cuid())
  compositeSessionId   String
  compositeSession     CompositeSession @relation(fields: [compositeSessionId], references: [id], onDelete: Cascade)
  youtubeVideoId       String
  youtubeVideo         YouTubeVideo   @relation(fields: [youtubeVideoId], references: [id])
  startSeconds         Float?
  endSeconds           Float?
  orderIndex           Int
  transitionType       TransitionType @default(NONE)
  transitionDurationMs Int            @default(500)
  chapterTitle         String?
  chapterDescription   String?

  @@unique([compositeSessionId, orderIndex])
}

model SessionOverlay {
  id                 String          @id @default(cuid())
  compositeSessionId String
  compositeSession   CompositeSession @relation(fields: [compositeSessionId], references: [id], onDelete: Cascade)
  type               OverlayType
  content            Json
  clipOrderIndex     Int?
  triggerAtSeconds   Float?
  durationMs         Int             @default(5000)
  position           OverlayPosition @default(CENTER)
  orderIndex         Int
}

// --- YouTube Video ---

model YouTubeVideo {
  id              String   @id @default(cuid())
  videoId         String   // YouTube video ID
  url             String
  title           String?
  authorName      String?
  thumbnailUrl    String?
  description     String?
  durationSeconds Int?     // Video duration in seconds
  transcript      String?  @db.Text  // Auto-fetched captions/transcript
  muxUploadId     String?   // Mux direct upload ID (set when creator uploads via wizard)
  muxAssetId      String?   // Mux video asset ID
  muxPlaybackId   String?   // Mux playback ID for HLS streaming
  muxStatus       String?   // "waiting" | "ready" | "errored"
  programId       String
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  // Virtual segmentation — long videos (>10 min) are split into child records per Gemini topic
  desiredSegmentCount Int     @default(1)  // 1 = no split; 2-4 = creator-directed split count
  parentVideoId String?
  parentVideo   YouTubeVideo?  @relation("VideoSegments", fields: [parentVideoId], references: [id], onDelete: Cascade)
  segments      YouTubeVideo[] @relation("VideoSegments")
  isSegment     Boolean        @default(false)
  segmentIndex  Int?
  startSeconds  Float?
  endSeconds    Float?

  actions       Action[]
  embeddings    Embedding[]
  clips         SessionClip[]
  analysis      VideoAnalysis?

  @@unique([programId, videoId])
  @@index([parentVideoId])
  @@index([muxUploadId])
}

// --- Video Analysis (Gemini-generated structured analysis) ---

model VideoAnalysis {
  id               String       @id @default(cuid())
  youtubeVideoId   String       @unique
  youtubeVideo     YouTubeVideo @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)
  summary          String       @db.Text
  fullTranscript   String?      @db.Text
  segments         Json         // TimestampedSegment[]
  topics           Json         // VideoTopic[]
  keyMoments       Json?        // VideoKeyMoment[]
  people           Json?        // VideoPerson[]
  durationSeconds  Int?
  model            String       @default("gemini-2.5-flash-preview-05-20")
  analyzedAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

// --- Program Draft (AI-generated, pending approval) ---

model ProgramDraft {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  draftJson  Json     // Full ProgramDraft schema as JSON
  status     DraftStatus @default(PENDING)
  createdAt  DateTime @default(now())
}

enum DraftStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// --- Promo Codes (creator-generated, for learner access) ---

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique     // stored uppercase
  creatorId String
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  programId String?   // null = applies to all creator's programs
  program   Program?  @relation(fields: [programId], references: [id], onDelete: Cascade)
  maxUses   Int?      // null = unlimited
  uses      Int       @default(0)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

// --- Custom Skin (AI-generated, creator-owned) ---

model CustomSkin {
  id        String   @id @default(cuid())
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name      String
  tokens    Json     // SkinTokens-compatible object (colors + fonts)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs  Program[]

  @@index([creatorId])
}

// --- Entitlement (purchase/enrollment) ---

model Entitlement {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  programId           String
  program             Program  @relation(fields: [programId], references: [id])
  stripeSessionId     String?  @unique
  stripePaymentIntent String?
  status              EntitlementStatus @default(ACTIVE)
  currentWeek         Int      @default(1)  // Which week the learner has access to
  createdAt           DateTime @default(now())

  // Set when count(weekCompletions) first reaches program.durationWeeks
  programCompletedAt    DateTime?
  // Idempotency stamp for the recap email pipeline; null = not yet sent
  completionEmailSentAt DateTime?

  weekCompletions     WeekCompletion[]

  @@unique([userId, programId])
}

// --- Week Completion Tracking ---

model WeekCompletion {
  id            String   @id @default(cuid())
  entitlementId String
  entitlement   Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  weekNumber    Int
  completedAt   DateTime @default(now())

  @@unique([entitlementId, weekNumber])
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// --- Learner Progress ---

model LearnerProgress {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionId       String
  // Cascade so regeneration's Week.deleteMany (which cascades through
  // Session → Action) doesn't trip the FK constraint when old progress
  // rows still reference the soon-to-be-deleted Actions. Orphan progress
  // is useless anyway.
  action         Action    @relation(fields: [actionId], references: [id], onDelete: Cascade)
  completed      Boolean   @default(false)
  completedAt    DateTime?
  reflectionText String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, actionId])
}

// --- AI: Embeddings ---

model Embedding {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  videoId    String
  video      YouTubeVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  model      String   // e.g. "sentence-transformers/all-MiniLM-L6-v2"
  vector     Json     // float[] stored as JSONB (use pgvector extension for production scale)
  createdAt  DateTime @default(now())

  @@unique([programId, videoId, model])
}

// --- AI: Cluster Assignments ---

model ClusterAssignment {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  videoId    String
  clusterId  Int
  createdAt  DateTime @default(now())

  @@unique([programId, videoId])
}

// --- Future: Cohort (stub, no UI wired) ---

model Cohort {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id])
  name       String
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime @default(now())
}

// --- Influencer for Style Matching ---

model Influencer {
  id              String   @id @default(cuid())
  name            String
  platform        String   // "youtube", "instagram", etc.
  platformHandle  String   // @username or channel ID
  avatarUrl       String?
  niche           String?
  styleProfile    Json?    // AI-generated style characteristics
  sampleVideoIds  String[] // YouTube video IDs analyzed for style
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  followers       UserInfluencer[]

  @@unique([platform, platformHandle])
}

// --- User-Influencer Follow Relationship ---

model UserInfluencer {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, influencerId])
}

// --- Program Artifact (metadata only - no file storage) ---

model ProgramArtifact {
  id               String   @id @default(cuid())
  programId        String
  program          Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  originalFilename String
  fileType         String   // "pdf", "docx"
  extractedText    String?  @db.Text
  metadata         Json?    // { pageCount, wordCount, etc. }
  createdAt        DateTime @default(now())
}

// --- Future: Program Rating (stub for now) ---

model ProgramRating {
  id                String    @id @default(cuid())
  programId         String    @unique
  program           Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  uniquenessScore   Float?    // 0-100 (future AI evaluation)
  completenessScore Float?    // 0-100 (future AI evaluation)
  evaluatedAt       DateTime?
  createdAt         DateTime  @default(now())
}

// --- Async Generation Job ---

model GenerationJob {
  id            String          @id @default(cuid())
  programId     String
  program       Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  status        GenerationStatus @default(PENDING)
  stage         String?         // "embedding", "clustering", "generating", "persisting"
  progress      Int             @default(0)  // 0-100
  error         String?         @db.Text
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([programId])
  @@index([status])
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// --- Ad Creative Render (ad-machine v1) ---

model CreativeRender {
  variationId    String           @id              // matches the API-generated id ("var-{ts}-{i}")
  hook           String           @db.Text
  body           String           @db.Text
  cta            String
  lane           String                            // "Fitness" | "Skill Builder" | "Business Coach" | "General"
  format         String                            // "Meta Feed" | "Meta Story" | "TikTok" | "YouTube"
  templateKey    String                            // "bold-statement" | "proof-numbers" | "transformation-arrow"
  laneTag        String?                           // uppercase tag rendered on the ad ("FITNESS CREATORS")
  proofNumber    String?                           // proof-numbers template only
  proofLabel     String?                           // proof-numbers template only
  ogParams       Json                              // exact params sent to /api/og — for re-render reproducibility
  canvaDesignId  String?                           // populated if archived to Canva (v2)
  blobUrl        String?                           // Vercel Blob PNG URL once rendered
  blobKey        String?                           // Vercel Blob key for deletion
  copyScore      Int?                              // 0-100 from /api/ops/score
  visualScore    Int?                              // 0-100 from /api/ops/creative/visual-score (v2)
  status         CreativeStatus   @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([templateKey])
  @@index([createdAt])
}

enum CreativeStatus {
  PENDING        // copy generated, not rendered
  BLOCKED        // failed copy score gate
  RENDERED       // PNG in blob, awaiting review
  APPROVED
  REJECTED
}
